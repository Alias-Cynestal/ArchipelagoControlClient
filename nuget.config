<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-local NuGet configuration.

  WHY THIS FILE EXISTS
    The user-level config restricts nuget.org to an explicit allow-list of package IDs. That is fine
    for the client's own dependencies, but it also blocks the .NET runtime packs
    (Microsoft.NETCore.App.Runtime.*, Microsoft.WindowsDesktop.App.Runtime.*, Microsoft.NET.ILLink.Tasks),
    which any RID-specific publish needs. Without them `dotnet publish -c Release` on
    tools/Ap.Control.Patcher fails with NU1100 and cannot produce the single-file exe.

  WHY IT RE-DECLARES EVERYTHING
    packageSourceMapping is NOT merged across config files — the nearest config's mapping section
    replaces the ones above it outright. So the client's own patterns have to be repeated here, or
    restoring Ap.Control itself would break the moment this file was added.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <!-- Client dependencies (carried over from the user-level config). -->
      <package pattern="Archipelago.MultiClient.Net" />
      <package pattern="Archipelago.MultiClient.Net.Analyzers" />
      <package pattern="KaitaiStruct.Runtime.CSharp" />

      <!-- .NET SDK targeting/runtime packs, required for single-file and self-contained publish. -->
      <package pattern="Microsoft.*" />
      <package pattern="runtime.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
